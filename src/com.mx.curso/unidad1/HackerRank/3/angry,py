# Language: Python

def count_on_time_students(arrival_times: list[int]) -> int:
    """
    Counts the number of students who arrived on time (arrival time <= 0).

    Args:
        arrival_times (list[int]): List of integers representing students' arrival times.

    Returns:
        int: Number of students who arrived on time.
    """
    return sum(1 for time in arrival_times if time <= 0)

def angry_professor(threshold: int, arrival_times: list[int]) -> str:
    """
    Determines if the class is canceled based on the threshold of on-time students.

    Args:
        threshold (int): Minimum number of students required to be on time.
        arrival_times (list[int]): List of integers representing students' arrival times.

    Returns:
        str: "NO" if class is not canceled, "YES" if class is canceled.
    """
    on_time_count = count_on_time_students(arrival_times)
    return "NO" if on_time_count >= threshold else "YES"

# Example call
result = angry_professor(3, [-2, -1, 0, 1, 2])
print(result)